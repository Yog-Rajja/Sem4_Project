# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# sqlite (default, zero setup) or postgres
DB_ENGINE=sqlite
# DB_NAME=smart_companion
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- LLM ---
# Provider is swappable in one line: gemini | groq
LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
# Newly created keys get no free-tier allocation for the gemini-2.0-* family
# (429 with "limit: 0"), and gemini-2.5-flash is closed to new users (404).
#
# IMPORTANT: the free tier allows only 20 generate requests per DAY, and the
# allowance is counted PER MODEL. If you exhaust one, switching this value to
# another Flash model gives you a fresh 20. Working alternatives:
#   gemini-3.5-flash  gemini-3.6-flash  gemini-flash-latest
#   gemini-3.5-flash-lite  gemini-flash-lite-latest  gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Set true to generate roadmaps from a local stub with no API call.
# Useful offline; leave false for the real demo.
USE_MOCK_AI=false

# --- Notifications ---
# Where the frontend is reachable; used for links inside notifications.
APP_BASE_URL=http://localhost:5173

# Web push. Generate a pair with:  python manage.py generate_vapid_keys
# This talks to the browser's own push service (FCM on Android, APNs on iOS),
# so there is no third-party notification account to sign up for.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com

# Email digests. Leave EMAIL_HOST_USER blank and mail is printed to the console
# instead of sent, so the feature works end-to-end with no mailbox at all.
# For Gmail you need an App Password, not your normal password:
#   https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Smart Companion <you@example.com>

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# search.list costs 100 units; free quota is 10,000/day (~100 lookups).
YOUTUBE_API_KEY=
