# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# sqlite (default, zero setup) or postgres
DB_ENGINE=sqlite
# DB_NAME=smart_companion
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- LLM ---
# Provider is swappable in one line: gemini | groq
LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Set true to generate roadmaps from a local stub with no API call.
# Useful offline; leave false for the real demo.
USE_MOCK_AI=false

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# search.list costs 100 units; free quota is 10,000/day (~100 lookups).
YOUTUBE_API_KEY=
